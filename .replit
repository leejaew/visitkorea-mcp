modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm --filter @workspace/landing install --frozen-lockfile && BASE_PATH=/ PORT=3000 pnpm --filter @workspace/landing run build && rm -rf .pythonlibs && python3.11 -m pip install --no-cache-dir -r visitkorea-mcp/requirements.txt"]
run = ["sh", "-c", "python3.11 visitkorea-mcp/main.py --http --host 0.0.0.0"]

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[[ports]]
localPort = 3001
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18150
externalPort = 3000

[nix]
channel = "stable-25_05"
