modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh","-c","pnpm --filter @workspace/landing install --frozen-lockfile && BASE_PATH=/ PORT=3000 pnpm --filter @workspace/landing run build && test -f visitkorea-mcp/deployment/python-deps.tar.gz"]
run = ["sh","-c","deps=/tmp/visitkorea-python-deps; rm -rf \"$deps\" && mkdir -p \"$deps\" && tar -xzf visitkorea-mcp/deployment/python-deps.tar.gz -C \"$deps\" && PYTHONNOUSERSITE=1 PYTHONPATH=\"$deps\" python3.11 visitkorea-mcp/main.py --http --host 0.0.0.0"]

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[[ports]]
localPort = 3001
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18150
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PYTHONUSERBASE = "/home/runner/.local"
PRODUCTION_MCP_URL = "https://visitkorea.jael.ee/mcp"
